# Referencja zmiennych. Samego .env nie wypełnia się dziś ręcznie —
# generuje go `vercel env pull .env`. Procedura: docs/dev-machine-setup.md

# Convex — NIE tutaj. Te trzy trafiają do .env.local, wypełnia je
# `pnpm exec convex dev` i są różne na każdej maszynie.
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Convex admin key (dla server-side mutations wołanych przez SvelteKit API routes)
# Deploy key z uprawnieniami runInternal*, generowany w dashboardzie Convexa
# (Settings -> Deploy Keys) osobno dla deploymentu dev i prod.
CONVEX_ADMIN_KEY=

# Clerk
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Dev-only allowlist for /admin (comma-separated emails). Ignored in production.
ADMIN_DEV_ALLOWLIST=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Brevo transactional email
BREVO_API_KEY=
BREVO_FROM_EMAIL=
CONTACT_EMAIL=
HANDOFF_REPORT_TO=msmolarski@jmsstudio.com

# Base URL used in transactional emails (link "Otwórz panel")
PUBLIC_APP_URL=https://sailing-architects.wysokijohn.pl

# Vercel Cron auth (Bearer token dla /api/admin/refunds/reconcile)
CRON_SECRET=
