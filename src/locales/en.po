msgstr ""

#: src/routes/[[lang=lang]]/polityka-prywatnosci/+page.svelte
msgid "<0>Wycofanie zgody</0> — zgodę na przetwarzanie informacji o zdrowiu i wymaganiach dietetycznych możesz wycofać w każdej chwili. Wycofanie nie wpływa na zgodność z prawem przetwarzania sprzed jego zgłoszenia."
msgstr ""

#: src/routes/[[lang=lang]]/polityka-prywatnosci/+page.svelte
