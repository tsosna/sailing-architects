msgstr ""

#: src/routes/[[lang=lang]]/polityka-prywatnosci/+page.svelte
msgid "<0>Przenoszenie danych</0> — możesz otrzymać dane, które nam podałeś, w formacie nadającym się do odczytu maszynowego i przekazać je innemu administratorowi."
msgstr ""

#: src/routes/[[lang=lang]]/polityka-prywatnosci/+page.svelte
